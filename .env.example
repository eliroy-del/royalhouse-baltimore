# ============================================================
# Royalhouse Baltimore — environment
# Copy to .env.local and fill in what you have. Everything here
# is optional for a local build, but forms need Resend in
# production so submissions reach the church inboxes.
#
# Vercel: do not add the same key twice. If the importer lists a
# variable that "already exists", delete the empty duplicate row
# and continue. Leave analytics blank until you have real IDs.
# ============================================================

# Canonical origin. Optional on Vercel — the deployment URL is used if this is empty.
NEXT_PUBLIC_SITE_URL=https://royalhousebaltimore.org

# Analytics. Scripts are only injected when the matching ID is present.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Public Google Form URLs (use the viewform link, not /edit).
NEXT_PUBLIC_CONNECT_FORM_URL=
NEXT_PUBLIC_SERVE_FORM_URL=

# Form email delivery (Resend). Required in production for contact,
# prayer, visit, newsletter, and testimony forms.
# Create a key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
# Must be a verified sender, e.g. "Royalhouse Baltimore <noreply@royalhousemd.org>"
FORM_FROM_EMAIL=
# Optional overrides (defaults to baltimore@royalhousemd.org)
FORM_TO_EMAIL=
PRAYER_TO_EMAIL=
